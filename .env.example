# ============================================================================
# AI Description Generator — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the required values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ============================================================================

# ---------------------------------------------------------------------------
# App Configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Groq API (REQUIRED)
# ---------------------------------------------------------------------------
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ---------------------------------------------------------------------------
# Upstash Redis — Server-Side Rate Limiting (REQUIRED for production)
# ---------------------------------------------------------------------------
# Get credentials from: https://console.upstash.com/
# IMPORTANT: Do NOT use the NEXT_PUBLIC_ prefix for these credentials.
# In development, the app falls back to in-memory rate limiting if unset.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ---------------------------------------------------------------------------
# Google Analytics 4 (Optional)
# ---------------------------------------------------------------------------
# Only loads if the user consents to analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Google AdSense (Optional)
# ---------------------------------------------------------------------------
# STEP 1 — Site Verification:
#   Set NEXT_PUBLIC_ADSENSE_CLIENT_ID to your publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX).
#   This enables the <meta name="google-adsense-account"> verification tag in the HTML head,
#   which is required for Google to verify your site ownership.
#   This value is safe to be public. Do NOT add a "client=" prefix here.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# STEP 2 — Enable Ad Serving (ONLY after your site is approved by AdSense):
#   Set to "true" ONLY after Google AdSense has reviewed and approved your site.
#   When "false" (default), the adsbygoogle.js script is never loaded and no ad
#   requests are made, even if a visitor has accepted advertising cookies.
#   The site-verification meta tag (Step 1) is unaffected by this flag.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# ---------------------------------------------------------------------------
# Monitoring API Security (Optional)
# ---------------------------------------------------------------------------
# If set, the GET /api/monitoring/usage endpoint requires a matching
# Bearer token in the Authorization header or X-Monitoring-Key header.
# Leave unset to allow unauthenticated access (development only).
MONITORING_SECRET_KEY=

# ---------------------------------------------------------------------------
# AI Pricing Overrides (Optional)
# ---------------------------------------------------------------------------
# Override the default per-million-token cost estimates.
# Default: 0.15 (input), 0.60 (output) — indicative rates for openai/gpt-oss-120b.
# AI_INPUT_PRICE_PER_MILLION=0.15
# AI_OUTPUT_PRICE_PER_MILLION=0.60

# ---------------------------------------------------------------------------
# Alert Thresholds (Optional)
# ---------------------------------------------------------------------------
# Override default operational alert thresholds.
# ALERT_MAX_DAILY_REQUESTS=1000
# ALERT_FAILURE_RATE_PERCENT=20
# ALERT_LATENCY_WARNING_MS=15000
# ALERT_DAILY_COST_USD=15.00
