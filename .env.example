# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Groq API for AI Generation
GROQ_API_KEY=your_groq_api_key_here

# Analytics & Ads (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Upstash Redis (Server-side Rate Limiting)
# Dapatkan dari Upstash Console: https://console.upstash.com/
# PENTING: Jangan gunakan prefix NEXT_PUBLIC_ untuk kredensial ini.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
